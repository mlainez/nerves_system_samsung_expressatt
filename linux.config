# Samsung Express SGH-I437: proven MSM8960 hardware, Linux 7.2.9.
# Nerves runtime policy is layered in linux-nerves.fragment.
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_QCOM=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HIGHMEM=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y
CONFIG_ATAGS=y
CONFIG_CMDLINE=""
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# The PM8921 and RPM provide supplies/clocks before eMMC and USB probe.
CONFIG_QCOM_SCM=y
CONFIG_QCOM_GSBI=y
CONFIG_MFD_PM8XXX=y
CONFIG_MFD_QCOM_RPM=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QCOM_RPM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_MSM_GCC_8960=y
CONFIG_MSM_MMCC_8960=y
CONFIG_QCOM_CLK_RPM=y
CONFIG_KPSS_XCC=y
CONFIG_PINCTRL_MSM8960=y
CONFIG_PINCTRL_QCOM_SSBI_PMIC=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_SMEM=y
CONFIG_MAILBOX=y
CONFIG_QCOM_SMSM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SPM=y
CONFIG_PM=y

# PL18x eMMC with Qualcomm BAM/DML; Android GPT remains intact.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_ARMMMCI=y
CONFIG_MMC_QCOM_DML=y
CONFIG_DMADEVICES=y
CONFIG_QCOM_BAM_DMA=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# Inherited lk2nd framebuffer is the console; no unsupported DRM takeover.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PMIC8XXX_PWRKEY=y

# Keep the stock-safe TE0 charging policy from the board DT patches.
CONFIG_I2C=y
CONFIG_I2C_GPIO=y
CONFIG_I2C_QUP=y
CONFIG_I2C_CHARDEV=y
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_BQ2415X=y
CONFIG_IIO=y
CONFIG_BATTERY_MAX17040=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_POWER_RESET=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_WATCHDOG=y
CONFIG_QCOM_WDT=y

# USB transport includes the independent RPM fabric vote from patch0021.
CONFIG_USB=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_MSM=y
CONFIG_USB_ULPI_BUS=y
CONFIG_PHY_QCOM_USB_HS=y

# Load WiFi after firmware and the private processed NV are on the rootfs.
CONFIG_NET=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WCN36XX=m
CONFIG_RFKILL=m
CONFIG_QRTR=m
CONFIG_REMOTEPROC=y
CONFIG_QCOM_WCNSS_PIL=m
CONFIG_QCOM_WCNSS_CTRL=m
CONFIG_QCOM_MDT_LOADER=m
CONFIG_QCOM_QMI_HELPERS=m
CONFIG_QCOM_SYSMON=m
CONFIG_QCOM_RPROC_COMMON=m
CONFIG_QCOM_PIL_INFO=m
