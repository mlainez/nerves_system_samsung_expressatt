From f28852a59bcd0ab736d1b2e974123b77b3527075 Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Wed, 14 Oct 2026 21:37:18 +0200
Subject: [PATCH 39/39] ARM: dts: qcom: Enable Express memory clock handoff

Connect the fixed memory-clock consumer to the active RPM AFAB/EBI1
clocks, L2 AUX and PLL8 vote, and independent PM8921 L24/S3 supplies.

Signed-off-by: Marc Lainez <marc.lainez@gmail.com>
---
 .../boot/dts/qcom/qcom-msm8960-samsung-expressatt.dts    | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/qcom-msm8960-samsung-expressatt.dts b/arch/arm/boot/dts/qcom/qcom-msm8960-samsung-expressatt.dts
index 7177591b8..c7d38b12f 100644
--- a/arch/arm/boot/dts/qcom/qcom-msm8960-samsung-expressatt.dts
+++ b/arch/arm/boot/dts/qcom/qcom-msm8960-samsung-expressatt.dts
@@ -13,6 +13,15 @@ / {
 	compatible = "samsung,expressatt", "qcom,msm8960";
 	chassis-type = "handset";
 
+	memory-clock-handoff {
+		compatible = "samsung,expressatt-memory-clock";
+		clocks = <&rpmcc RPM_APPS_FABRIC_A_CLK>, <&rpmcc RPM_EBI1_A_CLK>,
+			 <&l2cc>, <&gcc PLL8_VOTE>;
+		clock-names = "afab", "ebi1", "l2", "pll8";
+		mem-supply = <&pm8921_l24>;
+		dig-supply = <&pm8921_s3>;
+	};
+
 	aliases {
 		i2c13 = &battery_i2c;
 		serial0 = &gsbi5_serial;
-- 
