From d790b19dd65c54bbdc98ab75f8641140bfb504b6 Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Wed, 14 Oct 2026 21:37:17 +0200
Subject: [PATCH 37/39] dt-bindings: arm: qcom: Describe Express memory clock
 handoff

Describe the fixed memory-bus and L2 clock consumer on Samsung Express.
It owns MEM/DIG regulator votes and the RPM bus, L2 AUX and PLL8 clocks
needed to retain the stock fixed operating point.

Signed-off-by: Marc Lainez <marc.lainez@gmail.com>
---
 .../qcom/samsung,expressatt-memory-clock.yaml | 49 +++++++++++++++++++
 1 file changed, 49 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/arm/qcom/samsung,expressatt-memory-clock.yaml

diff --git a/Documentation/devicetree/bindings/arm/qcom/samsung,expressatt-memory-clock.yaml b/Documentation/devicetree/bindings/arm/qcom/samsung,expressatt-memory-clock.yaml
new file mode 100644
index 000000000..92b016237
--- /dev/null
+++ b/Documentation/devicetree/bindings/arm/qcom/samsung,expressatt-memory-clock.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/arm/qcom/samsung,expressatt-memory-clock.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Express fixed memory-bus and shared-cache clock handoff
+
+maintainers:
+  - Marc Lainez <marc.lainez@gmail.com>
+
+description: |
+  Board-specific fixed operating point for the MSM8960 memory buses and
+  shared Krait cache. Independent MEM and DIG supply references retain the
+  operating point across RIVA power transitions. Dynamic CPU/cache power
+  management is outside this handoff's lifecycle.
+
+properties:
+  compatible:
+    const: samsung,expressatt-memory-clock
+
+  clocks:
+    items:
+      - description: RPM active APPS fabric clock
+      - description: RPM active EBI1 clock
+      - description: KPSS shared-cache auxiliary mux
+      - description: GCC PLL8 vote clock
+
+  clock-names:
+    items:
+      - const: afab
+      - const: ebi1
+      - const: l2
+      - const: pll8
+
+  mem-supply:
+    description: PM8921 L24 shared-cache memory supply
+
+  dig-supply:
+    description: PM8921 S3 shared-cache digital supply
+
+required:
+  - compatible
+  - clocks
+  - clock-names
+  - mem-supply
+  - dig-supply
+
+additionalProperties: false
-- 
