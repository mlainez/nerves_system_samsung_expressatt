From ceb6af270163c1c335ef30bacccfb350ffce073e Mon Sep 17 00:00:00 2001
From: Marc Lainez <marc.lainez@gmail.com>
Date: Wed, 14 Oct 2026 21:37:18 +0200
Subject: [PATCH 38/39] ARM: qcom: Retain Express memory bus and shared cache
 clocks

Express can boot with AFAB at 13.5 MHz, EBI1 at 50 MHz and L2 on PXO.
The resulting memory latency makes native Nerves runtime operations slow.

Add a fixed-board built-in consumer that waits asynchronously for coherent
RPM bus publication, establishes independent MEM/DIG regulator votes, then
retains active bus floors and selects PLL8 for L2 using the vendor's
ordered secondary-mux sequence. Preserve CPU and HFPLL state throughout.

Defer missing suppliers without mutation. Bound readiness to 60 seconds,
report READY or FAILED through a read-only attribute, and retain resources
after ambiguous requests. Suppress unbind and restrict the configuration
to the existing fixed-clock, non-hotplug Express lifecycle.

The bus and L2 transitions have hardware evidence from bounded RAM trials.
Cold-boot publication timing and independent rail startup still require
installed-cohort verification; no successful cold boot is claimed here.

Signed-off-by: Marc Lainez <marc.lainez@gmail.com>
---
 arch/arm/mach-qcom/Kconfig             |  11 +
 arch/arm/mach-qcom/Makefile            |   1 +
 arch/arm/mach-qcom/expressatt-memory.c | 601 +++++++++++++++++++++++++
 3 files changed, 613 insertions(+)
 create mode 100644 arch/arm/mach-qcom/expressatt-memory.c

diff --git a/arch/arm/mach-qcom/Kconfig b/arch/arm/mach-qcom/Kconfig
index f4da153f2..21da29a52 100644
--- a/arch/arm/mach-qcom/Kconfig
+++ b/arch/arm/mach-qcom/Kconfig
@@ -35,4 +35,15 @@ config EXPRESSATT_CPU1_CLOCK
 	  request and disabled CPU1 HFPLL, and retains clock votes until
 	  reboot. CPU power/frequency transitions are not supported.
 
+config EXPRESSATT_MEMORY_CLOCK
+	bool "Retain Samsung Express memory bus and L2 clocks"
+	depends on EXPRESSATT_CPU1_CLOCK
+	depends on MFD_QCOM_RPM=y && QCOM_CLK_RPM=y && REGULATOR_QCOM_RPM=y
+	default y
+	help
+	  Establish independent MEM/DIG regulator votes, active memory-bus
+	  floors and the fixed PLL8 shared-cache clock on Samsung Express.
+	  Readiness is asynchronous and bounded. No CPU power transitions
+	  or removal are supported; failed requests retain votes until reboot.
+
 endif
diff --git a/arch/arm/mach-qcom/Makefile b/arch/arm/mach-qcom/Makefile
index 256c6d91c..752f772b2 100644
--- a/arch/arm/mach-qcom/Makefile
+++ b/arch/arm/mach-qcom/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0-only
 obj-$(CONFIG_SMP)	+= platsmp.o
 obj-$(CONFIG_EXPRESSATT_CPU1_CLOCK) += expressatt-cpu1.o
+obj-$(CONFIG_EXPRESSATT_MEMORY_CLOCK) += expressatt-memory.o
diff --git a/arch/arm/mach-qcom/expressatt-memory.c b/arch/arm/mach-qcom/expressatt-memory.c
new file mode 100644
index 000000000..4048dd8d4
--- /dev/null
+++ b/arch/arm/mach-qcom/expressatt-memory.c
@@ -0,0 +1,601 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Retain the Express fixed memory-bus and shared-cache operating point. */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/mfd/qcom_rpm.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <linux/smp.h>
+#include <linux/workqueue.h>
+#include <dt-bindings/clock/qcom,rpmcc.h>
+#include <dt-bindings/clock/qcom,gcc-msm8960.h>
+#include <dt-bindings/mfd/qcom-rpm.h>
+#include <asm/cp15.h>
+#include <asm/cputype.h>
+#include <asm/krait-l2-accessors.h>
+
+#define BUS_MIN_RATE 133000000UL
+#define RAIL_MIN_UV 1050000
+#define RAIL_MAX_UV 1150000
+#define READY_ATTEMPTS 600
+#define READY_DELAY_MS 100
+#define READY_TIMEOUT_MS 60000
+
+static const unsigned long addresses[] = {
+	0x02011028, 0x02088014, 0x02098014,
+	0x00903400, 0x00903200, 0x00903300,
+};
+
+static const int resources[] = { QCOM_RPM_APPS_FABRIC_CLK, QCOM_RPM_EBI1_CLK };
+
+struct l2_sample {
+	u32 midr, sctlr, mux[3], aux[3], pll[3][6];
+};
+
+struct expressatt_l2 {
+	void __iomem *maps[6];
+	struct clk *aux, *pll, *old_parent;
+	bool exclusive;
+	struct l2_sample before, after;
+	int error, rollback, aux_rollback;
+	bool apply, restore;
+};
+
+struct expressatt_memory {
+	struct device *dev;
+	struct delayed_work work;
+	struct regulator *rails[2];
+	struct clk *bus[2];
+	struct qcom_rpm *rpm;
+	struct expressatt_l2 l2;
+	bool exclusive[2], mutated, ready;
+	unsigned int attempts;
+	unsigned long targets[2], deadline;
+	u32 bus_before[2], bus_after[2];
+	int voltage[2], rail_after[2];
+	const char *phase;
+	/* Serialize the worker result with sysfs readers. */
+	struct mutex status_lock;
+	char status[256];
+};
+
+static void sample_l2(struct expressatt_l2 *l2, struct l2_sample *s)
+{
+	unsigned int i, j;
+
+	s->midr = read_cpuid_id();
+	s->sctlr = get_cr();
+	s->mux[0] = krait_get_l2_indirect_reg(0x0500);
+	s->mux[1] = krait_get_l2_indirect_reg(0x4501);
+	s->mux[2] = krait_get_l2_indirect_reg(0x5501);
+	for (i = 0; i < 3; i++) {
+		s->aux[i] = readl(l2->maps[i]);
+		for (j = 0; j < 6; j++)
+			s->pll[i][j] = readl(l2->maps[i + 3] + j * 4);
+	}
+}
+
+static void select_l2_secondary(u32 initial, u32 selection)
+{
+	u32 value = initial | BIT(4);
+
+	/* Order prior MMIO before the vendor indirect-register transaction. */
+	mb();
+	krait_set_l2_indirect_reg(0x0500, value);
+	value = (value & ~(3u << 2)) | (selection << 2);
+	/* Order prior MMIO before the vendor indirect-register transaction. */
+	mb();
+	krait_set_l2_indirect_reg(0x0500, value);
+	value &= ~BIT(4);
+	/* Order prior MMIO before the vendor indirect-register transaction. */
+	mb();
+	krait_set_l2_indirect_reg(0x0500, value);
+	/* Complete the source switch before its required settling delay. */
+	mb();
+	udelay(1);
+}
+
+static bool unchanged_fields(const struct l2_sample *a, const struct l2_sample *b)
+{
+	return a->midr == b->midr && a->sctlr == b->sctlr &&
+	       a->mux[1] == b->mux[1] && a->mux[2] == b->mux[2] &&
+	       a->aux[1] == b->aux[1] && a->aux[2] == b->aux[2] &&
+	       !memcmp(a->pll, b->pll, sizeof(a->pll));
+}
+
+static void on_cpu0(void *argument)
+{
+	struct expressatt_l2 *l2 = argument;
+	struct l2_sample observed;
+	unsigned long flags;
+
+	l2->error = -EINVAL;
+	if (smp_processor_id() != 0 ||
+	    (read_cpuid_id() & 0xff0ffc00) != 0x510f0400)
+		return;
+	local_irq_save(flags);
+	sample_l2(l2, &observed);
+	if ((observed.sctlr & 0x1005) != 0x1005)
+		goto out;
+	if (!l2->apply && !l2->restore) {
+		if (observed.mux[0] != 0x20 || observed.aux[0] != 0 ||
+		    (observed.pll[0][0] & 7) || observed.mux[1] != 1)
+			goto out;
+		if (observed.mux[2] != 8) {
+			if (!observed.mux[2])
+				l2->error = -EAGAIN;
+			goto out;
+		}
+		if (observed.aux[2] != 3 || (observed.pll[2][0] & 7))
+			goto out;
+		l2->before = observed;
+		l2->error = 0;
+		goto out;
+	}
+	if (!unchanged_fields(&l2->before, &observed) || observed.aux[0] != 3 ||
+	    observed.mux[0] != (l2->restore ? 0x28 : 0x20))
+		goto out;
+	select_l2_secondary(observed.mux[0], l2->restore ? 0 : 2);
+	sample_l2(l2, &l2->after);
+	if (l2->after.mux[0] == (l2->restore ? 0x20 : 0x28) &&
+	    l2->after.aux[0] == 3 && unchanged_fields(&l2->before, &l2->after)) {
+		l2->error = 0;
+		goto out;
+	}
+	l2->error = -EIO;
+	/* Keep PLL8 and all supplier votes even if restoration is uncertain. */
+	observed.mux[0] = krait_get_l2_indirect_reg(0x0500);
+	if ((observed.mux[0] & ~0xcu) != (l2->before.mux[0] & ~0xcu)) {
+		l2->rollback = -1;
+		goto out;
+	}
+	select_l2_secondary(observed.mux[0], 0);
+	l2->rollback = krait_get_l2_indirect_reg(0x0500) == 0x20 ? 1 : -1;
+out:
+	local_irq_restore(flags);
+}
+
+static int plan_rails(struct expressatt_memory *m)
+{
+	int value[2], enabled, i;
+
+	for (i = 0; i < 2; i++) {
+		enabled = regulator_is_enabled(m->rails[i]);
+		value[i] = regulator_get_voltage(m->rails[i]);
+		if (enabled < 0 || value[i] < 0 || value[i] > RAIL_MAX_UV)
+			return -EINVAL;
+	}
+	/* Zero is the RPM driver's uninitialized cache, not a voltage reading. */
+	m->voltage[1] = max(RAIL_MIN_UV, value[1]);
+	m->voltage[0] = max(m->voltage[1], max(RAIL_MIN_UV, value[0]));
+	return 0;
+}
+
+static int check_rails(struct expressatt_memory *m)
+{
+	int value[2], i;
+
+	for (i = 0; i < 2; i++) {
+		value[i] = regulator_get_voltage(m->rails[i]);
+		if (regulator_is_enabled(m->rails[i]) != 1 ||
+		    value[i] < m->voltage[i] || value[i] > RAIL_MAX_UV)
+			return -EINVAL;
+	}
+	if (value[0] < value[1])
+		return -EINVAL;
+	m->rail_after[0] = value[0];
+	m->rail_after[1] = value[1];
+	return 0;
+}
+
+static int read_bus_floors(struct expressatt_memory *m)
+{
+	unsigned long rate;
+	int ret, i;
+
+	for (i = 0; i < 2; i++) {
+		ret = qcom_rpm_read_status(m->rpm, resources[i], &m->bus_before[i]);
+		if (ret)
+			return ret == -EBUSY ? -EAGAIN : ret;
+		if (!m->bus_before[i] || m->bus_before[i] > (ULONG_MAX - 999) / 1000)
+			return -EAGAIN;
+		rate = clk_get_rate(m->bus[i]);
+		if (!rate || rate > ULONG_MAX - 999)
+			return -EAGAIN;
+		m->targets[i] = max(BUS_MIN_RATE,
+				    max(rate, (unsigned long)m->bus_before[i] * 1000));
+	}
+	return 0;
+}
+
+static int check_buses(struct expressatt_memory *m)
+{
+	int ret, i;
+
+	for (i = 0; i < 2; i++) {
+		ret = qcom_rpm_read_status(m->rpm, resources[i], &m->bus_after[i]);
+		if (ret)
+			return ret;
+		if (m->bus_after[i] < m->targets[i] / 1000 + !!(m->targets[i] % 1000))
+			return -EIO;
+	}
+	return 0;
+}
+
+static void release_exclusivity(struct expressatt_memory *m)
+{
+	int i;
+
+	if (m->l2.exclusive) {
+		clk_rate_exclusive_put(m->l2.aux);
+		m->l2.exclusive = false;
+	}
+	for (i = 1; i >= 0; i--)
+		if (m->exclusive[i]) {
+			clk_rate_exclusive_put(m->bus[i]);
+			m->exclusive[i] = false;
+		}
+}
+
+static int ready_to_apply(struct expressatt_memory *m)
+{
+	int ret;
+
+	m->phase = "bus-publication";
+	ret = read_bus_floors(m);
+	if (ret)
+		return ret;
+	m->phase = "rail-plan";
+	ret = plan_rails(m);
+	if (ret)
+		return ret;
+	m->phase = "core-state";
+	if (clk_get_rate(m->l2.aux) != 27000000 ||
+	    clk_get_rate(m->l2.pll) != 384000000)
+		return -EINVAL;
+	ret = smp_call_function_single(0, on_cpu0, &m->l2, 1);
+	return ret ? ret : m->l2.error;
+}
+
+static void restore_aux(struct expressatt_l2 *l2)
+{
+	int ret = clk_set_parent(l2->aux, l2->old_parent);
+
+	l2->aux_rollback = !ret && readl(l2->maps[0]) == 0 &&
+			   clk_get_rate(l2->aux) == 27000000 ? 1 : -1;
+}
+
+static int apply_handoff(struct expressatt_memory *m)
+{
+	struct expressatt_l2 *l2 = &m->l2;
+	int ret, i;
+
+	m->phase = "exclusive-clocks";
+	for (i = 0; i < 2; i++) {
+		ret = clk_rate_exclusive_get(m->bus[i]);
+		if (ret)
+			goto unchanged;
+		m->exclusive[i] = true;
+	}
+	ret = clk_rate_exclusive_get(l2->aux);
+	if (ret)
+		goto unchanged;
+	l2->exclusive = true;
+	ret = ready_to_apply(m);
+	if (ret)
+		goto unchanged;
+
+	/* No retry or resource release is safe after an ambiguous RPM request. */
+	m->mutated = true;
+	m->phase = "mem-dig-votes";
+	for (i = 0; i < 2; i++) {
+		ret = regulator_set_voltage(m->rails[i], m->voltage[i], RAIL_MAX_UV);
+		if (ret)
+			return ret;
+		ret = regulator_enable(m->rails[i]);
+		if (ret)
+			return ret;
+	}
+	ret = check_rails(m);
+	if (ret)
+		return ret;
+	m->phase = "bus-votes";
+	for (i = 0; i < 2; i++) {
+		ret = clk_set_rate(m->bus[i], m->targets[i]);
+		if (ret)
+			return ret;
+		ret = clk_prepare_enable(m->bus[i]);
+		if (ret)
+			return ret;
+	}
+	ret = check_buses(m);
+	if (ret)
+		return ret;
+	m->phase = "l2-parent";
+	ret = clk_prepare_enable(l2->pll);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(l2->aux);
+	if (ret)
+		return ret;
+	ret = clk_set_parent(l2->aux, l2->pll);
+	if (ret)
+		return ret;
+	if (readl(l2->maps[0]) != 3 || clk_get_rate(l2->aux) != 384000000) {
+		restore_aux(l2);
+		return -EIO;
+	}
+	m->phase = "l2-secondary";
+	l2->apply = true;
+	ret = smp_call_function_single(0, on_cpu0, l2, 1);
+	if (ret || l2->error)
+		return ret ? ret : l2->error;
+	m->phase = "postcondition";
+	ret = check_buses(m);
+	if (!ret)
+		ret = check_rails(m);
+	if (ret) {
+		l2->restore = true;
+		if (!smp_call_function_single(0, on_cpu0, l2, 1) && !l2->error) {
+			l2->rollback = 1;
+			restore_aux(l2);
+		} else {
+			l2->rollback = -1;
+		}
+	}
+	return ret;
+
+unchanged:
+	release_exclusivity(m);
+	return ret;
+}
+
+static void memory_work(struct work_struct *work)
+{
+	struct expressatt_memory *m = container_of(to_delayed_work(work),
+						 struct expressatt_memory, work);
+	int ret;
+
+	m->attempts++;
+	if (time_after_eq(jiffies, m->deadline)) {
+		m->phase = "readiness-timeout";
+		ret = -ETIMEDOUT;
+		goto publish;
+	}
+	ret = ready_to_apply(m);
+	if (!ret)
+		ret = apply_handoff(m);
+	if (ret == -EAGAIN && !m->mutated && m->attempts < READY_ATTEMPTS) {
+		mutex_lock(&m->status_lock);
+		scnprintf(m->status, sizeof(m->status), "PENDING attempt=%u limit=%u",
+			  m->attempts, READY_ATTEMPTS);
+		mutex_unlock(&m->status_lock);
+		schedule_delayed_work(&m->work, msecs_to_jiffies(READY_DELAY_MS));
+		return;
+	}
+	if (ret == -EAGAIN && !m->mutated)
+		ret = -ETIMEDOUT;
+publish:
+	mutex_lock(&m->status_lock);
+	m->ready = !ret;
+	if (ret)
+		scnprintf(m->status, sizeof(m->status), "FAILED phase=%s errno=%d",
+			  m->phase, ret);
+	else
+		scnprintf(m->status, sizeof(m->status),
+			  "READY afab_khz=%u ebi1_khz=%u mem_uv=%d dig_uv=%d l2_mux=%08x l2_aux=%08x",
+			  m->bus_after[0], m->bus_after[1], m->rail_after[0],
+			  m->rail_after[1], m->l2.after.mux[0],
+			  m->l2.after.aux[0]);
+	dev_info(m->dev, "%s; retained=%u secondary_rollback=%d aux_rollback=%d\n",
+		 m->status, m->mutated, m->l2.rollback, m->l2.aux_rollback);
+	mutex_unlock(&m->status_lock);
+}
+
+static ssize_t clock_handoff_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct expressatt_memory *m = dev_get_drvdata(dev);
+	ssize_t count;
+
+	mutex_lock(&m->status_lock);
+	count = sysfs_emit(buf, "%s\n", m->status);
+	mutex_unlock(&m->status_lock);
+	return count;
+}
+static DEVICE_ATTR_RO(clock_handoff);
+
+static struct attribute *memory_attrs[] = {
+	&dev_attr_clock_handoff.attr,
+	NULL,
+};
+
+static const struct attribute_group memory_group = {
+	.attrs = memory_attrs,
+};
+
+static void put_rpm_device(void *data)
+{
+	put_device(data);
+}
+
+static int get_suppliers(struct expressatt_memory *m)
+{
+	static const char * const names[] = { "afab", "ebi1", "l2", "pll8" };
+	struct device *dev = m->dev;
+	struct device_node *mem, *dig, *regulators = NULL, *dig_parent = NULL;
+	struct device_node *rpm_node = NULL, *rpmcc = NULL, *parent = NULL;
+	struct device_node *l2_node = NULL;
+	struct platform_device *rpm_dev;
+	struct of_phandle_args spec;
+	struct resource resource;
+	struct clk *clks[4], *expected;
+	int ret = -EINVAL, i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++)
+		if (of_property_match_string(dev->of_node, "clock-names", names[i]) != i)
+			return -EINVAL;
+
+	mem = of_parse_phandle(dev->of_node, "mem-supply", 0);
+	dig = of_parse_phandle(dev->of_node, "dig-supply", 0);
+	if (!mem || !dig || !of_node_name_eq(mem, "l24") || !of_node_name_eq(dig, "s3"))
+		goto nodes;
+	regulators = of_get_parent(mem);
+	dig_parent = of_get_parent(dig);
+	if (!regulators || regulators != dig_parent ||
+	    !of_device_is_compatible(regulators, "qcom,rpm-pm8921-regulators"))
+		goto nodes;
+	rpm_node = of_get_parent(regulators);
+	if (!rpm_node || !of_device_is_compatible(rpm_node, "qcom,rpm-msm8960") ||
+	    of_address_to_resource(rpm_node, 0, &resource) || resource.start != 0x108000 ||
+	    resource_size(&resource) < 0x1000)
+		goto nodes;
+	for (i = 0; i < 2; i++) {
+		ret = of_parse_phandle_with_args(dev->of_node, "clocks", "#clock-cells", i, &spec);
+		if (ret)
+			goto nodes;
+		ret = -EINVAL;
+		if (!of_device_is_compatible(spec.np, "qcom,rpmcc-msm8960") ||
+		    spec.args_count != 1 ||
+		    spec.args[0] != (i ? RPM_EBI1_A_CLK : RPM_APPS_FABRIC_A_CLK)) {
+			of_node_put(spec.np);
+			goto nodes;
+		}
+		if (!i) {
+			rpmcc = spec.np;
+		} else {
+			bool same = spec.np == rpmcc;
+
+			of_node_put(spec.np);
+			if (!same)
+				goto nodes;
+		}
+	}
+	parent = of_get_parent(rpmcc);
+	if (parent != rpm_node)
+		goto nodes;
+	ret = of_parse_phandle_with_args(dev->of_node, "clocks", "#clock-cells", 2, &spec);
+	if (ret)
+		goto nodes;
+	l2_node = spec.np;
+	ret = -EINVAL;
+	if (spec.args_count || !of_device_is_compatible(l2_node, "qcom,kpss-gcc-msm8960") ||
+	    of_address_to_resource(l2_node, 0, &resource) ||
+	    resource.start != 0x02011000 || resource_size(&resource) < 0x2c)
+		goto nodes;
+
+	m->rails[0] = devm_regulator_get_optional(dev, "mem");
+	if (IS_ERR(m->rails[0])) {
+		ret = PTR_ERR(m->rails[0]);
+		goto nodes;
+	}
+	m->rails[1] = devm_regulator_get_optional(dev, "dig");
+	if (IS_ERR(m->rails[1])) {
+		ret = PTR_ERR(m->rails[1]);
+		goto nodes;
+	}
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		clks[i] = devm_clk_get(dev, names[i]);
+		if (IS_ERR(clks[i])) {
+			ret = PTR_ERR(clks[i]);
+			goto nodes;
+		}
+	}
+	m->bus[0] = clks[0];
+	m->bus[1] = clks[1];
+	m->l2.aux = clks[2];
+	m->l2.pll = clks[3];
+	expected = of_clk_get_by_name(l2_node, "pll8_vote");
+	if (IS_ERR(expected)) {
+		ret = PTR_ERR(expected);
+		goto nodes;
+	}
+	ret = clk_is_match(expected, m->l2.pll) ? 0 : -EINVAL;
+	clk_put(expected);
+	if (ret)
+		goto nodes;
+	m->l2.old_parent = clk_get_parent(m->l2.aux);
+	if (!m->l2.old_parent) {
+		ret = -EPROBE_DEFER;
+		goto nodes;
+	}
+	rpm_dev = of_find_device_by_node(rpm_node);
+	ret = -EPROBE_DEFER;
+	if (!rpm_dev)
+		goto nodes;
+	m->rpm = dev_get_drvdata(&rpm_dev->dev);
+	if (!m->rpm) {
+		put_device(&rpm_dev->dev);
+		goto nodes;
+	}
+	ret = devm_add_action_or_reset(dev, put_rpm_device, &rpm_dev->dev);
+nodes:
+	of_node_put(l2_node);
+	of_node_put(parent);
+	of_node_put(rpmcc);
+	of_node_put(rpm_node);
+	of_node_put(dig_parent);
+	of_node_put(regulators);
+	of_node_put(dig);
+	of_node_put(mem);
+	return ret;
+}
+
+static int expressatt_memory_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct expressatt_memory *m;
+	int ret, i;
+
+	if (!of_machine_is_compatible("samsung,expressatt"))
+		return -ENODEV;
+	m = devm_kzalloc(dev, sizeof(*m), GFP_KERNEL);
+	if (!m)
+		return -ENOMEM;
+	m->dev = dev;
+	mutex_init(&m->status_lock);
+	scnprintf(m->status, sizeof(m->status), "PENDING attempt=0 limit=%u", READY_ATTEMPTS);
+	ret = get_suppliers(m);
+	if (ret)
+		return dev_err_probe(dev, ret, "memory clock suppliers unavailable\n");
+	for (i = 0; i < ARRAY_SIZE(addresses); i++) {
+		m->l2.maps[i] = devm_ioremap(dev, addresses[i], i < 3 ? 4 : 24);
+		if (!m->l2.maps[i])
+			return -ENOMEM;
+	}
+	platform_set_drvdata(pdev, m);
+	ret = devm_device_add_group(dev, &memory_group);
+	if (ret)
+		return ret;
+	INIT_DELAYED_WORK(&m->work, memory_work);
+	m->deadline = jiffies + msecs_to_jiffies(READY_TIMEOUT_MS);
+	/* Never block userspace or RIVA module loading on RPM publication. */
+	schedule_delayed_work(&m->work, 0);
+	return 0;
+}
+
+static const struct of_device_id expressatt_memory_match[] = {
+	{ .compatible = "samsung,expressatt-memory-clock" },
+	{}
+};
+
+static struct platform_driver expressatt_memory_driver = {
+	.probe = expressatt_memory_probe,
+	.driver = {
+		.name = "expressatt-memory-clock",
+		.of_match_table = expressatt_memory_match,
+		.suppress_bind_attrs = true,
+	},
+};
+
+static int __init expressatt_memory_init(void)
+{
+	return platform_driver_register(&expressatt_memory_driver);
+}
+late_initcall_sync(expressatt_memory_init);
