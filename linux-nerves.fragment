# Runtime baseline: official nerves_system_bbb 76d7aaa8, nerves_system_br 1.35.
# Hardware selections are kept in linux.config; this fragment is product policy.
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KERNEL_XZ=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_V1=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_NAMESPACES=y
# CONFIG_UTS_NS is not set
# CONFIG_IPC_NS is not set
# CONFIG_PID_NS is not set
# CONFIG_NET_NS is not set
CONFIG_SCHED_AUTOGROUP=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_SLAB_FREELIST_RANDOM=y
# CONFIG_COMPAT_BRK is not set
# CONFIG_SUSPEND is not set
CONFIG_EXPRESSATT_CPU1_CLOCK=y
CONFIG_EXPRESSATT_MEMORY_CLOCK=y

# Official Nerves networking: addresses and WiFi secrets are runtime policy.
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
# CONFIG_IPV6_SIT is not set
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_MPTCP=y
CONFIG_NETDEVICES=y
CONFIG_TUN=m
CONFIG_WIREGUARD=m
CONFIG_MAC80211_MESH=y
# CONFIG_CFG80211_DEFAULT_PS is not set
CONFIG_RFKILL_INPUT=y

# Built-in legacy Ethernet gadget, matching official BBB device-port policy.
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VBUS_DRAW=500
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=y
# CONFIG_USB_ETH_EEM is not set
# CONFIG_USB_CONFIGFS is not set
# CONFIG_USB_G_SERIAL is not set
# CONFIG_USB_CDC_COMPOSITE is not set
# CONFIG_USB_G_MULTI is not set

# The initramfs maps linear A/B/app slices inside the existing userdata.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
# CONFIG_BLK_DEV_LOOP is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT2_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_FILE_DIRECT=y
# CONFIG_SQUASHFS_LZ4 is not set
CONFIG_F2FS_FS=y
# CONFIG_F2FS_FS_XATTR is not set
CONFIG_FANOTIFY=y
CONFIG_VFAT_FS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_850=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# CONFIG_NETWORK_FILESYSTEMS is not set

# Watchdog recovery and persistent crash records remain product features.
CONFIG_WATCHDOG_NOWAYOUT=y
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set
CONFIG_PANIC_TIMEOUT=10
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# The bootloader supplies the actual slot/root arguments and console policy.
# CONFIG_CMDLINE_FORCE is not set
# CONFIG_CMDLINE_EXTEND is not set
# CONFIG_LOGO is not set
# CONFIG_FRAMEBUFFER_CONSOLE_ROTATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
# CONFIG_PRINTK_TIME is not set
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_PROFILING is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_RUNTIME_TESTING_MENU is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_MODVERSIONS is not set
# CONFIG_FW_LOADER_USER_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set
CONFIG_EXTRA_FIRMWARE=""
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_PCI is not set
# CONFIG_QCOM_Q6V5_MSS is not set
# CONFIG_QCOM_PM8XXX_XOADC is not set
# CONFIG_USB_CHIPIDEA_HOST is not set
# Legacy RIVA has no protection-domain mapper service.
# CONFIG_QCOM_PD_MAPPER is not set
CONFIG_HW_RANDOM=y
